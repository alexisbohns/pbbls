# Build output
build/
.gradle/
.kotlin/

# Local SDK location (machine-specific, written by Android Studio)
local.properties

# Secrets (D8) — copy secrets.example.properties → secrets.properties
secrets.properties

# APKs / bundles
*.apk
*.aab

# NOTE: app/src/screenshotTest*/reference/ is deliberately NOT ignored (#847).
# Those PNGs are the screenshot suite's baseline — `validateDebugScreenshotTest`
# diffs every rendered @PreviewTest against them and fails CI on a mismatch, so
# ignoring them again would turn the gate back into a no-op nobody notices.

# Android Studio / IntelliJ
.idea/
*.iml
.cxx/
captures/
