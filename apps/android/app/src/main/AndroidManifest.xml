<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- supabase-kt (auth, OAuth, Postgrest) requires network access. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- enableOnBackInvokedCallback: predictive back (a stated minSdk-33
         rationale, design D1). BackHandler call sites remain authoritative
         for in-app back handling. -->
    <application
        android:name=".PebblesApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pebbles">

        <!--
          Large screens (#855): phones are portrait-locked, like the iPhone-only
          iOS app. From Android 16 (targetSdk 36 and up; this app targets 37)
          the system ignores orientation and resizability restrictions on
          displays of 600 dp and wider, so tablets, foldables and desktop
          windows still rotate and resize: the adaptive layer (the 600 dp
          readable column, the navigation rail) is what carries them, not this
          attribute. Do NOT add <compatible-screens> — it hides the app on
          devices it runs fine on.

          The two lint checks this trips (LockedOrientationActivity, DiscouragedApi)
          are suppressed here, on purpose: both warn about exactly the large-screen
          case that Android 16 already exempts, and the lock is a product decision
          (decision log 2026-09-26), not an oversight for the baseline to hold.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Pebbles.Starting"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              OAuth deep-link return (D15). The Google hosted-OAuth custom tab
              redirects to pebbles://auth-callback; singleTask + this filter route
              it back to the existing MainActivity, where supabase-kt's
              handleDeeplinks(intent) parses the session. Scheme+host are shared
              with iOS, so the Supabase dashboard allowlist needs no change
              (verify on device — risk 1 in the milestone design).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pebbles" android:host="auth-callback" />
            </intent-filter>

            <!--
              Invite App Links (M49). The one canonical invite URL is
              https://www.pbbls.app/invite/<token> — no custom scheme, because
              the https link is its own fallback: not-installed users land on
              the web accept page instead of a browser error. autoVerify pairs
              with /.well-known/assetlinks.json served by apps/web, which reads
              the Play App Signing SHA-256 from the ANDROID_ASSETLINKS_SHA256
              env var — unset it and this filter silently stops verifying, which
              removes invite-accept from the app (#697). Runbook step 4b in
              docs/android-play-deploy.md.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.pbbls.app" android:pathPrefix="/invite/" />
            </intent-filter>

            <!--
              OAuth App Link return (#852). https://www.pbbls.app/auth/callback is
              the web-hosted OAuth redirect target; pebbles://auth-callback above
              stays as the fallback for a browser that doesn't hand the https link to
              the app (autoVerify not yet run, or the user picked the browser once).
              Same assetlinks.json as the invite filter above — see its comment for
              the ANDROID_ASSETLINKS_SHA256 dependency.

              ⚠ THIS FILTER IS CURRENTLY INERT FOR OAUTH, AND THAT IS A TRAP.
              supabase-kt is installed with `scheme = "pebbles"; host =
              "auth-callback"` (di/SupabaseModule.kt), so `handleDeeplinks` only
              recognises the custom-scheme return. Supabase's configured redirect
              still points there, so nothing sends a user to the https URL today
              and this filter never fires for sign-in.

              If you switch the Supabase redirect URL to the https one, the intent
              WILL reach this activity and `handleDeeplinks` will silently ignore
              it — the app opens and the sign-in never completes, with no error.
              Change `scheme`/`host` in SupabaseModule in the same edit, or delete
              this filter. The invite App Link is unaffected either way: it is
              parsed by `parseInviteToken`, not by supabase-kt.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.pbbls.app"
                    android:pathPrefix="/auth/callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
