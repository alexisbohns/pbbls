<?xml version="1.0" encoding="utf-8"?>
<!--
  `android:roundIcon` is redundant on an adaptive icon — the launcher's own mask
  already makes it round — but a few OEM launchers still resolve the attribute,
  so it points at the same layers rather than at nothing (#846). Keep identical
  to ic_launcher.xml.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
