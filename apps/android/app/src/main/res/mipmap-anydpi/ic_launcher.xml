<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon (#846). Adaptive from the start: minSdk is 33, so there is
  no pre-API-26 device to ship density-bucketed PNGs for, and the layers are
  vectors — one drawable serves every density.

  `monochrome` is the themed-icon layer. Themed icons are one of the stated
  reasons minSdk is 33 (design D1), so the app is expected to have one.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
