{
  "name": "@pbbls/supabase",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "deno check supabase/functions/*/index.ts scripts/*.ts",
    "test": "deno test supabase/functions/sweep-orphan-snaps/ scripts/oracles/achievements/ && node scripts/oracles/path-wrap/test.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff",
    "db:migration:new": "supabase migration new",
    "db:migration:list": "supabase migration list",
    "db:link": "supabase link",
    "db:types": "supabase gen types typescript --local 2>/dev/null > types/database.ts",
    "db:types:remote": "supabase gen types typescript --linked 2>/dev/null > types/database.ts",
    "db:verify": "npm run db:verify:moments && npm run db:verify:visibility && npm run db:verify:public-profile && npm run db:verify:guard && npm run db:verify:reference && npm run db:verify:reports && npm run db:verify:glyph && npm run db:verify:recent-auth && npm run db:verify:path-wraps && npm run db:verify:guides && npm run db:verify:home && npm run db:verify:achievements && npm run db:verify:settings-links",
    "db:verify:moments": "deno run --allow-env --allow-net scripts/verify-moments.ts",
    "db:verify:visibility": "deno run --allow-env --allow-net scripts/verify-pebble-visibility.ts",
    "db:verify:public-profile": "deno run --allow-env --allow-net scripts/verify-public-profile.ts",
    "db:verify:guard": "deno run --allow-env --allow-net scripts/verify-profiles-privileged-guard.ts",
    "db:verify:reference": "deno run --allow-env --allow-net --allow-read scripts/verify-reference-data.ts",
    "db:verify:reports": "deno run --allow-env --allow-net scripts/verify-content-reports.ts",
    "db:verify:glyph": "deno run --allow-env --allow-net scripts/verify-glyph-usability.ts",
    "db:verify:recent-auth": "deno run --allow-env --allow-net scripts/verify-recent-auth.ts",
    "db:verify:path-wraps": "deno run --allow-env --allow-net --allow-read scripts/verify-path-wraps.ts",
    "db:verify:guides": "deno run --allow-env --allow-net scripts/verify-guides.ts",
    "db:verify:settings-links": "deno run --allow-env --allow-net scripts/verify-settings-links.ts",
    "db:verify:home": "deno run --allow-env --allow-net --allow-read --allow-write scripts/verify-home.ts",
    "db:verify:achievements": "deno run --allow-env --allow-net --allow-read --allow-write scripts/verify-achievements.ts",
    "db:verify:purge": "deno run --allow-env --allow-net scripts/verify-account-purge.ts",
    "db:verify:moderation": "deno run --allow-env --allow-net scripts/verify-moderation-state.ts",
    "db:verify:sweep": "deno run --allow-env --allow-net scripts/verify-orphan-snap-sweep.ts",
    "db:reference:pull": "deno run --allow-env --allow-net --allow-write scripts/pull-reference-data.ts"
  }
}
